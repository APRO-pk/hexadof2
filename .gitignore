# Rust and the Cargo workspace.
#
# The workspace shares one target directory at the repository root, so this one
# entry covers every crate and the desktop shell.
/target/
**/*.rs.bk
*.pdb

# The frontend build output. It is regenerated by `npm run build` and again by
# the Tauri build hook before any bundled build, so it is never committed.
node_modules/
**/dist/

# Tauri writes the capability and ACL schemas here on every build. The
# `$schema` reference in capabilities/default.json resolves once a build has
# run, and is only there for editor completion.
apps/desktop/src-tauri/gen/schemas/

# A bundle produced from the desktop crate's own target directory, if one is
# ever created by building from inside that directory.
apps/desktop/src-tauri/target/

# The layout check writes one screenshot per screen state, and a report beside
# them. Both are inspection output, not source.
tools/layout-check/out/
tools/layout-check/report.json

# Editor and operating system noise.
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# Local environment files are never part of this project.
.env
.env.*
*.log
